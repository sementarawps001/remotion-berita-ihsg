{
  "name": "remotion-berita-ihsg",
  "version": "1.0.0",
  "description": "Template video breaking news berita IHSG anjlok menggunakan Remotion",
  "scripts": {
    "start": "remotion preview",
    "build": "remotion render IHSGBreakingNews out/ihsg-news.mp4",
    "build:vertical": "remotion render IHSGBreakingNewsVertical out/ihsg-news-vertical.mp4",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.537"
  },
  "devDependencies": {
    "@remotion/cli": "^4.0.537",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "typescript": "^5.6.3"
  }
}
